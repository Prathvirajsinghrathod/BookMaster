@model CreateBookVm
<h1>New Book</h1>
<div asp-validation-summary="All" class="error"></div>
<form method="post">
    <label>Title</label>
    <input asp-for="Title" /><br />
    <label>Owner</label>
    <select asp-for="OwnerId">
        @foreach (var u in (List<UserVm>)ViewBag.Users)
        {
            <option value="@u.Id">@u.Name</option>
        }
    </select><br />
    <label>Category</label>
    <select asp-for="CategoryId">
        @foreach (var c in (List<CategoryVm>)ViewBag.Categories)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select><br />
    <button type="submit">Create</button>
</form>
