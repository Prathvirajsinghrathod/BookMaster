@model List<UserVm>
<h1>Users</h1>
<a href="/Users/Create">New User</a>
<table>
    <tr><th>Id</th><th>Name</th><th>Email</th><th></th></tr>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Id</td>
            <td>@u.Name</td>
            <td>@u.Email</td>
            <td><a href="/Users/Details/@u.Id">View</a></td>
        </tr>
    }
</table>
